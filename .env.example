# Leave both blank to use local storage in ./data/library.json.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# For npm run build && npm start without Supabase, on a trusted local network only.
# Development (npm run dev) already allows local mode.
REFSITE_ALLOW_LOCAL=false

# Optional absolute path for local data, e.g. D:/RefSite/data
# REFSITE_DATA_DIR=
